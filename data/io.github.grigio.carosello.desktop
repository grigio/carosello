[Desktop Entry]
Name=Carosello
Comment=A fast, minimalist image and video viewer for Linux
Exec=carosello %U
Icon=io.github.grigio.carosello
Terminal=false
Type=Application
Categories=Graphics;Photography;Viewer;AudioVideo;Video;Player;
Keywords=image;video;viewer;photo;picture;gallery;movie;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/tiff;image/x-tiff;video/mp4;video/webm;video/x-matroska;
StartupWMClass=io.github.grigio.carosello
StartupNotify=true
X-GNOME-UsesNotifications=true
